{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.stufently/cloudru-s3-mcp-ai-cli",
  "description": "Cloud.ru S3 MCP server and AI CLI with scoped access and human approval for destructive actions.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/stufently/cloudru-s3-mcp-ai-cli",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/stufently/cloudru-s3-mcp-ai-cli:0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLOUDRU_S3_ACCESS_KEY_ID",
          "description": "S3 access key ID",
          "isSecret": true
        },
        {
          "name": "CLOUDRU_S3_SECRET_ACCESS_KEY",
          "description": "S3 secret access key",
          "isSecret": true
        },
        {
          "name": "CLOUDRU_S3_POOL",
          "default": "ru-central-1",
          "description": "Signing pool"
        },
        {
          "name": "CLOUDRU_S3_ENDPOINT",
          "description": "Optional endpoint override"
        },
        {
          "name": "CLOUDRU_S3_ALLOW_INSECURE",
          "description": "Set 1 only for explicit HTTP test endpoints"
        },
        {
          "name": "CLOUDRU_S3_ALLOW",
          "description": "Independent write,delete,admin levels; read only by default"
        },
        {
          "name": "CLOUDRU_S3_DESTRUCTIVE_POLICY",
          "default": "confirm",
          "choices": [
            "confirm",
            "elicit",
            "block",
            "allow"
          ]
        },
        {
          "name": "CLOUDRU_S3_ALLOWED_BUCKETS",
          "description": "Comma-separated bucket scope"
        },
        {
          "name": "CLOUDRU_S3_ALLOWED_PREFIXES",
          "description": "Comma-separated bucket/prefix/ scope"
        },
        {
          "name": "CLOUDRU_S3_FILE_ROOT",
          "format": "filepath",
          "description": "Optional confined local file root"
        },
        {
          "name": "CLOUDRU_S3_AUDIT_FILE",
          "format": "filepath",
          "description": "Optional private append-only audit output"
        }
      ]
    }
  ]
}
